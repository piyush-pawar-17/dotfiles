{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "padding": {
      "top": 0,
      "right": 3
    },
    "color": {
      "1": "#89b4fa",
      "2": "#cba6f7"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "     󰮚",
      "format": "{1} @ {2}",
      "keyColor": "#cba6f7"
    },
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "     󰣇 OS      ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "host",
      "key": "     󰌢 Host    ",
      "format": "{2}",
      "keyColor": "#f9e2af"
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "keyColor": "#94e2d5"
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "keyColor": "#cba6f7"
    },
    {
      "type": "terminal",
      "key": "     󰞷 Terminal",
      "keyColor": "#f5c2e7"
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────╯"
    },
    "break",
    {
      "type": "cpu",
      "key": "     󰻠 CPU     ",
      "format": "{1}",
      "keyColor": "#89b4fa"
    },
    {
      "type": "gpu",
      "key": "     󰢮 GPU     ",
      "format": "{2}",
      "keyColor": "#f9e2af"
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
      "keyColor": "#a6e3a1"
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "format": "{width}x{height} @ {refresh-rate} Hz",
      "keyColor": "#94e2d5"
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 5
    }
  ]
}
