{
    "layer": "top",
    "position": "top",
    "height": 34,
    "exclusive": true,
    "spacing": 8,
    "modules-left": ["custom/arch", "hyprland/workspaces"],
    "custom/arch": {
        "exec": "printf ''",
        "format": "{}",
        "interval": "once"
    },
    "modules-center": ["custom/ycal"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "battery"],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "custom/ycal": {
        "interval": 60,
        "exec": "~/.config/waybar-ycal/bar.py",
        "on-click": "/usr/share/waybar-ycal/toggle.sh",
        "return-type": "json"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        }
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{signalStrength}% signal",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}"
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },
    "memory": {
        "interval": 5,
        "format": "󰘚 {}%",
        "tooltip-format": "{used:0.1f}G used of {total:0.1f}G"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
