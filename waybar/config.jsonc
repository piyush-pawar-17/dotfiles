{
    "layer": "top",
    "position": "top",
    "height": 34,
    "exclusive": true,
    "spacing": 8,
    "modules-left": [
        "custom/arch",
        "custom/workspace-1",
        "custom/workspace-2",
        "custom/workspace-3",
        "custom/workspace-4",
        "custom/workspace-5",
        "custom/workspace-6",
        "custom/workspace-7",
        "custom/workspace-8",
        "custom/workspace-9",
        "custom/workspace-10"
    ],
    "custom/arch": {
        "exec": "printf ''",
        "format": "{}",
        "interval": "once"
    },
    "modules-center": ["custom/ycal"],
    "modules-right": ["pulseaudio", "custom/brightness", "custom/connectivity", "battery", "cpu", "memory", "tray", "custom/notification"],
    "custom/workspace-1": {
        "exec": "python3 ~/.config/waybar/workspace.py 1",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 1 }))'"
    },
    "custom/workspace-2": {
        "exec": "python3 ~/.config/waybar/workspace.py 2",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 2 }))'"
    },
    "custom/workspace-3": {
        "exec": "python3 ~/.config/waybar/workspace.py 3",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 3 }))'"
    },
    "custom/workspace-4": {
        "exec": "python3 ~/.config/waybar/workspace.py 4",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 4 }))'"
    },
    "custom/workspace-5": {
        "exec": "python3 ~/.config/waybar/workspace.py 5",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 5 }))'"
    },
    "custom/workspace-6": {
        "exec": "python3 ~/.config/waybar/workspace.py 6",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 6 }))'"
    },
    "custom/workspace-7": {
        "exec": "python3 ~/.config/waybar/workspace.py 7",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 7 }))'"
    },
    "custom/workspace-8": {
        "exec": "python3 ~/.config/waybar/workspace.py 8",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 8 }))'"
    },
    "custom/workspace-9": {
        "exec": "python3 ~/.config/waybar/workspace.py 9",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 9 }))'"
    },
    "custom/workspace-10": {
        "exec": "python3 ~/.config/waybar/workspace.py 10",
        "return-type": "json",
        "on-click": "hyprctl eval 'return hl.dispatch(hl.dsp.focus({ workspace = 10 }))'"
    },
    "custom/ycal": {
        "interval": 60,
        "exec": "~/.config/waybar-ycal/bar.py",
        "on-click": "/usr/share/waybar-ycal/toggle.sh",
        "return-type": "json"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 8
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "on-click": "python3 ~/.config/waybar/myui-popup-toggle.py volume",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        }
    },
    "custom/brightness": {
        "exec": "brightnessctl -m | cut -d, -f4",
        "format": "󰃟 {}",
        "interval": 2,
        "on-click": "python3 ~/.config/waybar/myui-popup-toggle.py brightness",
        "tooltip": false
    },
    "custom/connectivity": {
        "exec": "python3 ~/.config/waybar/orbit-connectivity.py",
        "return-type": "json",
        "interval": 3,
        "on-click": "orbit toggle top-right"
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },
    "memory": {
        "interval": 5,
        "format": "󰘚 {}%",
        "tooltip-format": "{used:0.1f}G used of {total:0.1f}G"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
